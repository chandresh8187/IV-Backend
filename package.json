{
  "name": "iv-backend",
  "version": "1.0.0",
  "description": "IV Square Structure production management API",
  "main": "server.js",
  "scripts": {
    "dev": "npm run unit1:migrate && nodemon server.js",
    "start": "npm run migrate && npm run unit1:migrate && npm run start:server",
    "start:server": "node server.js",
    "migrate": "node scripts/migrate.js up",
    "unit1:migrate": "node scripts/migrateUnit1Coils.js",
    "unit1:user:create": "node scripts/createUnit1User.js",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:dry-run": "node scripts/migrate.js up --dry-run",
    "schema:check": "node scripts/checkSchema.js",
    "migration:create": "node scripts/createMigration.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "dotenv-flow": "^4.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pdf-lib": "^1.17.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pdf-parse": "^2.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.6": true
  }
}
